        "output_size": 16
      }
    },
    "slow_weather_encoder": {
      "encoder": "weather_slow",
      "parameter_target": 4897,
      "parameter_tolerance": 0.10,
      "encoder_config": {
        "slow_hidden_size": 23,
        "output_size": 16
      }
    },
    "dual_weather_encoder": {
      "encoder": "weather_dual",
      "parameter_target": 4897,
      "parameter_tolerance": 0.10
