  "experiment_contract": {
    "document": "icing_model_experiment_protocol_cn.docx",
    "reuse_completed_models": true,
    "reference_gru_model": "gru_weather_reference",
    "reference_gru_root": "results/icing_model_experiments/weather_ablation",
    "reused_fair_baseline_root": "results/recurrence_modeling/fair_baselines",
    "selection_year": 2022,
    "frozen_evaluation_years": [2023, 2024],
