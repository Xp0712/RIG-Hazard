{
  "data_root": "data/meteorology_raw",
  "output_root": "results/preprocessed_data_10min",
  "station_metadata": "configs/station_metadata.csv",
  "time_step_minutes": 10,
  "chunksize": 200000,
  "output_format": "csv.gz",
  "compression_level": 1,
  "event": {
    "ice_threshold": 0.0,
    "merge_gap_minutes": 10,
    "cooldown_minutes": 60,
    "cold_plausible_temperature_c": 2.0,
    "minimum_positive_minutes": 1,
    "use_only_cold_plausible_events_as_targets": true
  },
  "risk_set": {
    "history_hours": 6,
    "forecast_horizons_hours": [1, 3, 6],
    "minimum_observed_minutes_per_bin": 1,
    "minimum_history_bin_fraction": 0.9,
    "minimum_history_observation_fraction": 0.8,
    "minimum_future_label_bin_fraction": 1.0
  },
  "exposure": {
    "temperature_c": 2.0,
    "relative_humidity_percent": 95.0,
    "visibility_m": 1000.0,
    "lookback_hours": 1
  },
  "graph": {
    "spatial_candidate_neighbors": 8
  },
  "splits": {
    "development": {
      "train_years": [2022],
      "validation_years": [2023],
      "test_years": [2024]
    },
    "final": {
      "train_years": [2022, 2023],
      "validation_years": [],
      "test_years": [2024]
    }
  },
  "valid_ranges": {
    "device_voltage": [0.0, 30.0],
    "ice_thickness": [0.0, null],
    "ice_sensor_frequency": [0.0, null],
    "air_temperature": [-50.0, 60.0],
    "relative_humidity": [0.0, 100.0],
    "station_pressure": [300.0, 1100.0],
    "rain": [0.0, 500.0],
    "hourly_rain": [0.0, 500.0],
    "wind_direction": [0.0, 360.0],
    "wind_speed": [0.0, 75.0],
    "visibility": [0.0, 50000.0]
  }
}
